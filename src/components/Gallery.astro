---
import type { ImageMetadata } from "astro";
import Photo from "./Photo.astro";
import type { Lang } from "../i18n";

interface Props {
  images: { src: ImageMetadata; alt: Record<Lang, string> }[];
  lang: Lang;
}

const { images, lang } = Astro.props;
---

<div class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:gap-3 lg:grid-cols-4">
  {
    images.map((image) => (
      <Photo
        src={image.src}
        alt={image.alt[lang]}
        lang={lang}
        widths={[400, 600, 800]}
        sizes="(min-width: 1152px) 263px, (min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw"
        class="aspect-4/3"
      />
    ))
  }
</div>
