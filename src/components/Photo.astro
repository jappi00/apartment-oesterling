---
// Responsive image that opens in the page-wide lightbox (see Lightbox.astro)
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";
import { t, type Lang } from "../i18n";

interface Props {
  src: ImageMetadata;
  alt: string;
  lang: Lang;
  widths: number[];
  sizes: string;
  /** Classes for the link wrapper (sizing, aspect ratio, rounding) */
  class?: string;
  eager?: boolean;
}

const { src, alt, lang, widths, sizes, class: className = "", eager = false } = Astro.props;
const large = await getImage({ src, width: Math.min(src.width, 1920), format: "webp" });
---

<a
  href={large.src}
  data-zoom
  data-alt={alt}
  aria-label={`${t(lang).lightbox.zoom}: ${alt}`}
  class:list={["group block cursor-zoom-in overflow-hidden rounded-photo bg-sky", className]}
>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
    class="size-full object-cover transition duration-300 group-hover:scale-[1.02] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
  />
</a>
